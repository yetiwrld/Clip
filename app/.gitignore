# Dependencies
node_modules/

# Build output
out/
dist/

# Runtime workspaces and user data.
# Anchored to this folder: an unanchored `workspace/` also ignored
# src/renderer/features/workspace/, which is source code, not user data.
/.workspace/
/.test-workspace/
/workspace/

# Generated test fixtures (repeatable via `npm run fixtures`)
tests/fixtures/media/
tests/fixtures/transcript.json

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# TypeScript incremental build info
*.tsbuildinfo

# Python bytecode
__pycache__/
*.py[cod]
